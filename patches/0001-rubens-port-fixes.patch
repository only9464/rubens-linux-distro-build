diff --git a/drivers/misc/rubens-bootlog.c b/drivers/misc/rubens-bootlog.c
index cad646dd81..d82ef521e2 100644
--- a/drivers/misc/rubens-bootlog.c
+++ b/drivers/misc/rubens-bootlog.c
@@ -7,7 +7,9 @@
 #include <linux/delay.h>
 #include <linux/device/driver.h>
 #include <linux/fcntl.h>
+#include <linux/fs.h>
 #include <linux/init.h>
+#include <linux/kdev_t.h>
 #include <linux/kernel.h>
 #include <linux/kmsg_dump.h>
 #include <linux/module.h>
@@ -24,7 +26,7 @@
 #define RUBENS_BOOTLOG_PAYLOAD_SIZE	(RUBENS_BOOTLOG_SLOT_SIZE - \
 					 RUBENS_BOOTLOG_HEADER_SIZE)
 #define RUBENS_BOOTLOG_SLOTS	2
-#define RUBENS_BOOTLOG_PERIOD	(10 * HZ)
+#define RUBENS_BOOTLOG_PERIOD	(2 * HZ)
 
 struct rubens_bootlog_header {
 	__le32 magic;
@@ -194,11 +196,120 @@ static bool rubens_bootlog_target_path(char *buf, size_t len)
 	return false;
 }
 
+/*
+ * LOCAL PORT CHANGE (rubens-ubuntu, 2026-09-27): resolve the target through
+ * sysfs on the failure path.
+ *
+ * Diagnosed on the device: the oops partition is completely empty after every
+ * boot attempt, even though this driver takes a synchronous snapshot from
+ * device_initcall_sync and PARTNAME=oops really is the GPT label
+ * (/sys/class/block/sdc81/uevent -> PARTNAME=oops).  So the synchronous flush
+ * must be failing to open the device.
+ *
+ * The two existing paths both fail in an initramfs:
+ *   early_lookup_bdev()  -- only works once the UFS LUNs and the partition
+ *                           scan are done, which is not guaranteed at
+ *                           device_initcall_sync time;
+ *   /dev/disk/by-partlabel/oops -- a udev symlink, and this port boots an
+ *                           initramfs with no udev at all.
+ *
+ * This adds a third path that needs neither: walk the per-partition "uevent"
+ * files under /sys/class/block, looking for PARTNAME=<target>, then read the
+ * sibling "dev" attribute for major:minor and build the dev_t with MKDEV().
+ * Block devices and their sysfs attributes are registered by the block layer
+ * itself, so this works as soon as the partition exists, with no udev and no
+ * mounted rootfs.
+ */
+static bool rubens_bootlog_lookup_partlabel(const char *label, dev_t *out)
+{
+	static const char *const sysblock = "/sys/class/block";
+	struct file *f;
+	char buf[256];
+	char uevent[256];
+	char devpath[128];
+	char want[64];
+	unsigned int major, minor;
+	int i;
+
+	if (strncmp(label, "PARTLABEL=", 10))
+		return false;
+	snprintf(want, sizeof(want), "PARTNAME=%s", label + 10);
+
+	for (i = 0; i < 128; i++) {
+		snprintf(devpath, sizeof(devpath), "%s/sdc%d/uevent", sysblock, i);
+		f = filp_open(devpath, O_RDONLY, 0);
+		if (IS_ERR(f))
+			continue;
+		memset(uevent, 0, sizeof(uevent));
+		if (kernel_read(f, uevent, sizeof(uevent) - 1, &f->f_pos) > 0) {
+			filp_close(f, NULL);
+			if (!strstr(uevent, want))
+				continue;
+		} else {
+			filp_close(f, NULL);
+			continue;
+		}
+		snprintf(devpath, sizeof(devpath), "%s/sdc%d/dev", sysblock, i);
+		f = filp_open(devpath, O_RDONLY, 0);
+		if (IS_ERR(f))
+			continue;
+		memset(buf, 0, sizeof(buf));
+		if (kernel_read(f, buf, sizeof(buf) - 1, &f->f_pos) > 0 &&
+		    sscanf(buf, "%u:%u", &major, &minor) == 2) {
+			filp_close(f, NULL);
+			*out = MKDEV(major, minor);
+			pr_info("rubens-bootlog: %s resolved via sysfs to %u:%u\n",
+				label, major, minor);
+			return true;
+		}
+		filp_close(f, NULL);
+	}
+	return false;
+}
+
 /*
  * Resolve and open the oops partition lazily: at late_initcall the UFS LUNs
  * may not be registered yet, and a failure there must not disable the panic
  * dumper.  Called from the periodic flush and from the panic path itself.
  */
+/*
+ * LOCAL PORT CHANGE (rubens-ubuntu, 2026-09-27): last-resort resolution by a
+ * fixed partition minor.
+ *
+ * Both other paths are timing-dependent and both were observed to fail on this
+ * device: early_lookup_bdev() needs the asynchronous UFS/SCSI partition scan to
+ * have completed, and the sysfs walk needs /sys/class/block to be populated.
+ * bdev_file_open_by_dev() is synchronous, so opening by dev_t directly removes
+ * every timing dependency.
+ *
+ * Values read from the live device:
+ *   /sys/class/block/sdc81/uevent -> MAJOR=259 MINOR=65 DEVNAME=sdc81
+ *   /sys/class/block/sdc81/uevent -> PARTNAME=oops
+ *   The device has 88 GPT partitions; sdc81 is the oops partition.  The minor
+ *   is allocated in disk discovery order, not by GPT index, so the measured
+ *   value (65) is used verbatim rather than derived.
+ *
+ * The major (259) is the dynamic block major the kernel hands out for
+ * partitions; sdc itself is 8:32, i.e. the fixed SCSI disk major.
+ *
+ * Overridable at boot with rubens_bootlog.devt_major / .devt_minor for other
+ * boards; setting both to 0 disables this path.
+ */
+static unsigned int rubens_bootlog_fixed_major = 259;
+static unsigned int rubens_bootlog_fixed_minor = 65;
+module_param_named(devt_major, rubens_bootlog_fixed_major, uint, 0400);
+module_param_named(devt_minor, rubens_bootlog_fixed_minor, uint, 0400);
+
+static bool rubens_bootlog_resolve_fixed(dev_t *out)
+{
+	if (!rubens_bootlog_fixed_major && !rubens_bootlog_fixed_minor)
+		return false;
+	*out = MKDEV(rubens_bootlog_fixed_major, rubens_bootlog_fixed_minor);
+	pr_info("rubens-bootlog: falling back to devt %u:%u\n",
+		rubens_bootlog_fixed_major, rubens_bootlog_fixed_minor);
+	return true;
+}
+
 static bool rubens_bootlog_open_bdev(void)
 {
 	struct rubens_bootlog_header *header;
@@ -211,6 +322,11 @@ static bool rubens_bootlog_open_bdev(void)
 
 	if (rubens_bootlog_resolve_early()) {
 		devt = rubens_bootlog_devt;
+	} else if (rubens_bootlog_lookup_partlabel(rubens_bootlog_target,
+						   &devt)) {
+		/* got it from sysfs */
+	} else if (rubens_bootlog_resolve_fixed(&devt)) {
+		/* got it from the fixed partition number */
 	} else {
 		if (!rubens_bootlog_target_path(path, sizeof(path)) ||
 		    lookup_bdev(path, &devt))
@@ -380,21 +496,37 @@ static int __init rubens_bootlog_init(void)
 	rubens_bootlog_resolve_early();
 
 	/*
-	 * Take the first snapshot synchronously: late_initcall_sync runs in
-	 * process context and committing a record before the initcalls return
-	 * maximizes the chance of capturing a crash early in userspace. The
-	 * flush reschedules itself for the periodic updates.
+	 * Take the first snapshot synchronously: running at late_initcall (see
+	 * the registration below) puts this in process context with kthreadd,
+	 * sysfs and the UFS/SCSI stack all up, and committing a record before
+	 * the initcalls return maximizes the chance of capturing a crash early
+	 * in userspace.  The flush reschedules itself for the periodic updates.
 	 */
 	rubens_bootlog_flush(NULL);
 	return 0;
 }
+
 /*
- * Arm as early as possible: device_initcall_sync runs before every late
- * initcall, so the periodic snapshot and the panic dumper are live before
- * cfg80211's regulatory init, the connectivity stack or anything else can
- * hang.  The oops partition is opened lazily.
+ * LOCAL PORT CHANGE (rubens-ubuntu, 2026-09-27): registered at late_initcall
+ * instead of device_initcall_sync.
+ *
+ * Measured on the device: the oops partition stays byte-for-byte zero after
+ * every boot attempt, i.e. the first (synchronous) flush never commits.  Two
+ * things can keep it from working at device_initcall_sync level (initcall
+ * level 6):
+ *
+ *   - the sysfs fallback added above uses filp_open()/kernel_read(), which
+ *     need kthreadd and a working sysfs;
+ *   - early_lookup_bdev() only succeeds once the SCSI disk and its partitions
+ *     have been scanned, which is asynchronous.
+ *
+ * late_initcall runs at level 7, right after every level-6 driver has probed,
+ * so both are satisfied.  The device is observed to live for roughly 4 s and
+ * userland is never reached, so this is still early enough to be useful: if
+ * the partition is empty again after this change, the kernel is dying before
+ * late_initcall, and that is itself the answer.
  */
-device_initcall_sync(rubens_bootlog_init);
+late_initcall(rubens_bootlog_init);
 
 MODULE_LICENSE("GPL");
 MODULE_DESCRIPTION("Rubens early printk snapshot to a raw block partition");
diff --git a/tools/build-rubens-bootimg.sh b/tools/build-rubens-bootimg.sh
new file mode 100755
index 0000000000..4433c02d12
--- /dev/null
+++ b/tools/build-rubens-bootimg.sh
@@ -0,0 +1,180 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Package the rubens boot.img for the mainline port.
+#
+#   tools/build-rubens-bootimg.sh <Image> <initramfs.cpio.gz> <out/boot.img>
+#
+# Geometry is taken from the stock image read back on this device (2026-09-27):
+#
+#   unpack_bootimg --boot_img boot_a.img --format mkbootimg
+#     --header_version 4 --os_version 12.0.0 --os_patch_level 2024-09 \
+#     --kernel <kernel> --ramdisk <ramdisk> --cmdline ''
+#
+#   stock layout: kernel 19,610,141 B + ramdisk 1,875,758 B + a 4096-byte GKI
+#   boot signature, all 4096-aligned after a one-page header.
+#
+# Two deliberate differences from the stock image:
+#
+#   1. No boot signature.  mkbootimg only emits one when a GKI signing key is
+#      passed, and the signature covers the stock ramdisk, which we replace.
+#      The bootloader is unlocked (ro.boot.verifiedbootstate=orange) and the
+#      KernelSU-repacked boot.img -- a modified ramdisk with the header fields
+#      and signature left untouched, i.e. equally unverifiable -- boots on this
+#      exact device, so LK is not checking it.
+#
+#   2. No dtb in boot.img.  CONFIG_XIAOMI_RUBENS=y makes the kernel embed the
+#      rubens DTB itself and install it as initial_boot_params, overriding the
+#      Android DT that LK hands over (commit 34fa0624fd).  The stock boot.img
+#      has dtb_size 0 as well, so the layout is unchanged.
+#
+# The kernel is NOT compressed here: the stock image carries a raw arm64 Image
+# and LK decompresses it.  Do not pass Image.gz.
+
+set -eu
+
+srcdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+image=${1:?usage: $0 <Image> <initramfs.cpio.gz> <out.img>}
+ramdisk=${2:?usage: $0 <Image> <initramfs.cpio.gz> <out.img>}
+out=${3:?usage: $0 <Image> <initramfs.cpio.gz> <out.img>}
+
+for f in "$image" "$ramdisk"; do
+	[ -f "$f" ] || { printf 'missing input: %s\n' "$f" >&2; exit 1; }
+done
+command -v mkbootimg >/dev/null 2>&1 || {
+	printf '%s\n' "mkbootimg not found (install mkbootimg, or put the AOSP" \
+		"mkbootimg.py on PATH as 'mkbootimg')" >&2; exit 1; }
+
+# ---- guard: the arm64 header image_size decides whether LK boots at all ----
+# "keep the kernel image within the LK image budget" (commit 6b238ad86b):
+# 0x3640000 boots, 0x3820000 reset-loops.  Read the value LK reads.
+python3 - "$image" <<'PY'
+import struct, sys
+p = sys.argv[1]
+with open(p, 'rb') as f:
+    hdr = f.read(64)
+if hdr[:4] not in (b'\x4d\x5a\x00\x00',) and hdr[56:60] != b'ARM\x64':
+    # the magic is at offset 56 in the arm64 Image header
+    pass
+magic = hdr[56:60]
+if magic != b'ARM\x64':
+    print(f"warning: {p} does not look like an arm64 Image (magic {magic!r})", file=sys.stderr)
+image_size = struct.unpack_from('<Q', hdr, 16)[0]
+limit = 0x3640000
+boots = 0x3640000
+fails = 0x3820000
+print(f"arm64 Image header: image_size = 0x{image_size:x} ({image_size/1048576:.1f} MiB)")
+print(f"  LK budget: 0x{boots:x} boots / 0x{fails:x} reset-loops (limit {limit/1048576:.1f} MiB)")
+if image_size > limit:
+    sys.exit("FAIL: image_size is over the LK budget; disable CONFIG_KALLSYMS_ALL "
+             "or move built-in code to modules before flashing")
+print("  OK: inside the LK budget")
+PY
+
+# ---- guard: the boot ramdisk has its own, much tighter budget --------------
+rdsize=$(stat -c %s "$ramdisk")
+if [ "$rdsize" -gt 4194304 ]; then
+	printf 'FAIL: boot ramdisk is %s bytes, over the ~4 MiB LK budget\n' "$rdsize" >&2
+	exit 1
+fi
+
+# ---- pack exactly the way the working xaga build does -----------------------
+#
+# MT6895-Mainline's own build project (Laodelaisi/xaga-mt6895-mainline-build,
+# build-mainline.sh) packs with this set and says so twice, in capitals:
+#
+#   "boot 头部参数, 与 postmarketOS wiki 一致"
+#   "必须与 postmarketOS wiki 中 Pack boot image 中的一致，别乱改"
+#
+#   BASE=0x3fff8000  KERNEL_OFFSET=0x8000  PAGESIZE=4096
+#   RAMDISK_OFFSET=0x26f08000  TAGS_OFFSET=0x07c88000  DTB_OFFSET=0x07c88000
+#   HEADER_VERSION=4  OS_VERSION=16.0.0  OS_PATCH_LEVEL=2026-08
+#
+# and it gzips the kernel first:
+#   gzip -n -9 -c arch/arm64/boot/Image > Image.gz
+#   mkbootimg --kernel Image.gz --ramdisk initramfs.cpio.lz4 ...
+#
+# The kernel load address that matters is base + kernel_offset = 0x40000000.
+# The previous attempts packed with mkbootimg's defaults (base 0x10000000) and
+# with a raw, uncompressed Image, and the kernel came up far enough to bring the
+# USB gadget online and then panicked.  A wrong load address produces exactly
+# that shape of failure, so this now follows the known-good recipe.
+#
+# The boot signature padding below is kept: the stock image declares a
+# 4096-byte signature slot and the KernelSU-repacked image that demonstrably
+# boots on this device kept it too, so it costs nothing to match.
+gzipped="$out.gzkernel"
+gzip -n -9 -c "$image" > "$gzipped"
+
+mkbootimg \
+	--header_version 4 \
+	--os_version 16.0.0 \
+	--os_patch_level 2026-08 \
+	--pagesize 4096 \
+	--base 0x3fff8000 \
+	--kernel_offset 0x8000 \
+	--ramdisk_offset 0x26f08000 \
+	--tags_offset 0x07c88000 \
+	--dtb_offset 0x07c88000 \
+	--kernel "$gzipped" \
+	--ramdisk "$ramdisk" \
+	--output "$out"
+rm -f "$gzipped"
+
+# ---- pad the boot signature slot so the LK-visible layout is byte-identical
+# to the stock image.  mkbootimg only emits the 4096-byte boot signature when a
+# GKI signing key is supplied, so it writes boot_signature_size = 0.
+#
+# The stock image has 4096, and the KernelSU-repacked image on this device kept
+# 4096 through its repack.  An image whose declared layout differs from every
+# image this bootloader is known to have accepted is a needless variable during
+# bring-up: the first boot attempt produced no display and no serial output,
+# which is also what a blunt "LK refuses to load the kernel" looks like.
+#
+# Zero padding reproduces the layout, not the signature -- the bootloader is
+# unlocked and does not verify it.  PAD_SIGNATURE=0 disables this.
+if [ "${PAD_SIGNATURE:-1}" = "1" ]; then
+	pad=4096
+	# Boot image header v4 field offsets, from mkbootimg.py:
+	#   BOOT_IMAGE_HEADER_V3_SIZE = 1580  (everything before the signature
+	#                                      size field)
+	#   BOOT_IMAGE_HEADER_V4_SIZE = 1584  (plus the 4-byte signature size)
+	#   BOOT_IMAGE_HEADER_V3_PAGESIZE = 4096  (the header is padded to a page)
+	# so boot_signature_size lives at byte 1580, and the data area starts at
+	# 4096.
+	python3 - "$out" "$pad" <<'PY'
+import struct, sys, os
+path, pad = sys.argv[1], int(sys.argv[2])
+SIGSIZE_OFF = 1580
+PAGE = 4096
+size = os.path.getsize(path)
+with open(path, 'r+b') as f:
+    f.seek(SIGSIZE_OFF)
+    cur = struct.unpack('<I', f.read(4))[0]
+    if cur == pad:
+        note = f"boot_signature_size already {pad}, layout already matches stock"
+    elif cur == 0:
+        body = (size + PAGE - 1) // PAGE * PAGE
+        f.seek(0, 2)
+        if size < body:
+            f.write(b'\0' * (body - size))
+        f.write(b'\0' * pad)
+        f.seek(SIGSIZE_OFF)
+        f.write(struct.pack('<I', pad))
+        note = (f"padded boot signature slot to {pad} bytes "
+                f"(image {size} -> {os.path.getsize(path)})")
+    else:
+        note = f"unexpected boot_signature_size {cur}, left alone"
+print(f"  {note}")
+PY
+fi
+
+printf 'built %s (%s bytes, kernel %s, ramdisk %s)\n' \
+	"$out" "$(stat -c %s "$out")" "$(stat -c %s "$image")" "$rdsize"
+
+# ---- read it back so a broken header cannot reach fastboot ----------------
+if command -v unpack_bootimg >/dev/null 2>&1; then
+	tmp=$(mktemp -d)
+	trap 'rm -rf "$tmp"' EXIT
+	unpack_bootimg --boot_img "$out" --out "$tmp" 2>&1 | sed 's/^/  /'
+fi
