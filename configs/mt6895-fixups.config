# Fixups for the arm64 defconfig of the MT6895 branches.
#
# `make defconfig` in MT6895-Mainline/linux turns these on as modules, but their
# source does not compile on these branches: mt8183/mt8188/mt8192/mt8195/mt8196/
# mt8189 afe drivers reference fields (ch_num_reg, int_odd_flag_reg, ...) that do
# not exist in `struct mtk_base_memif_data` in
# sound/soc/mediatek/common/mtk-afe-fe-dai.h, so `make modules` stops in
# sound/soc/mediatek with "no member named ...".
#
# They are audio front ends for other MediaTek SoCs and are useless on MT6895, so
# the rootfs build switches them off.  Device profiles that pin the config of a
# real device (pearl does) already have them off and skip this fragment.
#
# Remove an entry here once the branch makes the driver build again.
CONFIG_SND_SOC_MT8183=n
CONFIG_SND_SOC_MT8183_MT6358_TS3A227E_MAX98357A=n
CONFIG_SND_SOC_MT8183_DA7219_MAX98357A=n
CONFIG_SND_SOC_MT8188=n
CONFIG_SND_SOC_MT8188_MT6359=n
CONFIG_SND_SOC_MT8189=n
CONFIG_SND_SOC_MT8192=n
CONFIG_SND_SOC_MT8192_MT6359_RT1015_RT5682=n
CONFIG_SND_SOC_MT8195=n
CONFIG_SND_SOC_MT8195_MT6359=n
CONFIG_SND_SOC_MT8196=n
CONFIG_SND_SOC_MT8365=n
CONFIG_SND_SOC_MT8365_MT6357=n
